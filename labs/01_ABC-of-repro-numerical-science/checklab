scriptpath=../../ciscripts/lab01.py

if [ ! -f ${scriptpath} ]; then
    echo "File ${scriptpath} not found."
    echo "Make sure that you run ./checklab from the lab's directory."
    echo "Exiting with error..."
    exit 1
fi

for cmd in python3 python; do
    if which ${cmd} > /dev/null 2>&1; then
       ${cmd} ${scriptpath}
       exit $?
    fi
done

echo "Could not find any useable Python command."
echo "Exiting with error..."
exit 1
